{
  "name": "@openreason/sdk",
  "version": "0.1.0",
  "description": "Validate and cryptographically verify OpenReason Protocol (ORP) documents — in Node and the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openreason",
    "orp",
    "attestation",
    "provenance",
    "ed25519",
    "data-governance",
    "verifiable",
    "reasoning"
  ],
  "homepage": "https://openreasonprotocol.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/openreasonprotocol/openreason.git",
    "directory": "sdk-js"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
